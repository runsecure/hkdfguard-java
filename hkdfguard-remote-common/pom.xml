<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.runsecure</groupId>
    <artifactId>hkdfguard-parent</artifactId>
    <version>0.9.1</version>
  </parent>

  <artifactId>hkdfguard-remote-common</artifactId>
  <name>HkdfGuard Remote Common</name>
  <description>
    Internal to HkdfGuard: the strict JSON reader that takes secrets out of response bodies without
    making them Strings. Not an API for applications.
  </description>

  <!--
    One copy of code that hkdfguard-cache, hkdfguard-integration-hashicorpvault and
    hkdfguard-keywrapping-hashicorpvault all need but can't take from one another: a key wrapper sits
    below the key ring and caches, so it can't depend on hkdfguard-cache. A fix to the JSON reader
    lands once for all three. The Vault rules this module once held as well are VaultHttp, in
    hkdfguard-integration-hashicorpvault, which the Vault cache and key wrapper now share with the
    Vault client.

    The module exports its package only to those three modules.
  -->

  <properties>
    <!-- Internal, exported only to three modules of this build: its public members are commented
         like the package-private code they came from, not tag by tag like an application API.
         Every other doclint check stays on. -->
    <doclint>all,-missing</doclint>
  </properties>

  <!-- No dependency: JsonReader needs only the JDK. -->
</project>
