<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.runsecure</groupId>
    <artifactId>hkdfguard-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>hkdfguard-keywrapping-v1</artifactId>
  <name>HkdfGuard KeyWrapping V1</name>
  <description>
    Wraps DEKs under a KEK held by the platform's native HkdfGuard KMS library (TPM, Platform Crypto
    Provider, Secure Enclave), called through the Java FFM API.
  </description>

  <!--
    No native library is packed into this artifact. Each platform's native KMS library is installed
    separately, to a fixed location, and loaded only from there after verification:
      Windows: %ProgramFiles%\HkdfGuard\v1\HkdfGuard.dll          (WindowsNativeLibraryLoader)
      macOS:   /Library/Application Support/HkdfGuard/v1/libhkdfguard.dylib, or
               ~/.hkdfguard/v1/libhkdfguard.dylib               (MacOsNativeLibraryLoader)
      Linux:   /usr/lib/<multiarch>/libhkdfguard.so.1, or /usr/lib64/libhkdfguard.so.1
               (the libhkdfguard1 package)                         (LinuxNativeLibraryLoader)
    Applications must grant this module native access with the JVM's enable-native-access option,
    naming io.github.runsecure.hkdfguard.keywrapping.v1 (or ALL-UNNAMED on the class path).
  -->

  <properties>
    <!-- Java 25, unlike the rest of the library (Java 21): the native KMS calls use the Foreign
         Function & Memory API, which Java 21 only has as a preview. Don't lower this by moving to
         JNI or JNA: the native loaders' verification itself runs through FFM, and JNA unpacks its
         own native library to a temporary directory - both would weaken how the KMS library is
         verified before it is trusted with every DEK. -->
    <maven.compiler.release>25</maven.compiler.release>
    <hkdfguard.test.argLine>--enable-native-access=io.github.runsecure.hkdfguard.keywrapping.v1,ALL-UNNAMED</hkdfguard.test.argLine>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.github.runsecure</groupId>
      <artifactId>hkdfguard-abstractions</artifactId>
    </dependency>
    <dependency>
      <groupId>org.bouncycastle</groupId>
      <artifactId>bcprov-jdk18on</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- NativeTestEnvironment - which provisioned service the native tests use, and where key
           files may be written - lives in hkdfguard-test-support, shared with the native tests of
           hkdfguard-dataencryptionkey and hkdfguard-cache. This module can't depend on it (it
           depends on this module), so its sources are compiled into this module's tests instead:
           the same package, so the helper reaches the interop package's package-private loaders
           here as there. Nothing of it ships in this module's jar. -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>add-test-support-sources</id>
            <phase>generate-test-sources</phase>
            <goals>
              <goal>add-test-source</goal>
            </goals>
            <configuration>
              <sources>
                <source>${project.basedir}/../hkdfguard-test-support/src/main/java</source>
              </sources>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
