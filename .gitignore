# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# Maven build output
target/

# Maven tooling leftovers: the versions plugin's POM backups (versions:set and
# friends write one per POM unless told not to), release-plugin state, and
# POMs generated by the shade and flatten plugins.
*.versionsBackup
pom.xml.tag
pom.xml.releaseBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
.flattened-pom.xml

# Signing and publishing credentials. The release workflow reads the GPG key
# and Central token from GitHub environment secrets; an exported key or a
# settings.xml with a token must never land in the repository by accident.
# (Signatures Maven generates are under target/, already ignored.)
*.asc
*.gpg
*.pgp
*.key
secring.*
/settings.xml
.env

# IDE and editor metadata
.idea/
*.iml
.vscode/
.classpath
.project
.settings/
.factorypath
out/

# Operating system files
.DS_Store
Thumbs.db
