<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.runsecure</groupId>
    <artifactId>hkdfguard-parent</artifactId>
    <version>0.9.1</version>
  </parent>

  <artifactId>hkdfguard-pipeline-hashicorpvault</artifactId>
  <name>HkdfGuard Pipeline HashiCorp Vault</name>
  <description>
    A provisioning pipeline's writer over one HashiCorp Vault KV secrets engine: pulls a fixed list
    of secrets over Vault's HTTP API, encrypts each at once with a pipeline data protector, and
    writes one encrypted file per secret, with no key ring.
  </description>

  <!-- The tests serve a fake Vault with the JDK's com.sun.net.httpserver (module jdk.httpserver),
       as hkdfguard-cache-hashicorpvault's do. They are compiled and run inside this module, patched
       in on the module path, so that module is added to the graph and this one made to read it - for
       the tests alone: the shipped module doesn't require it. -->
  <properties>
    <!-- Java 25, like hkdfguard-pipeline. -->
    <maven.compiler.release>25</maven.compiler.release>
    <hkdfguard.httpserver.reads>--add-reads=io.github.runsecure.hkdfguard.pipeline.hashicorpvault=jdk.httpserver</hkdfguard.httpserver.reads>
    <hkdfguard.test.argLine>--enable-native-access=ALL-UNNAMED --add-modules=jdk.httpserver ${hkdfguard.httpserver.reads}</hkdfguard.test.argLine>
  </properties>

  <!-- No dependency beyond hkdfguard-pipeline and hkdfguard-integration-hashicorpvault, for the token
       source, errors and HTTP rules every HkdfGuard caller of Vault shares: Vault is called through
       the JDK's java.net.http, so a secret is read straight into an array of its own and never
       becomes a String. Never hkdfguard-cache-hashicorpvault, the runtime cache. -->
  <dependencies>
    <dependency>
      <groupId>io.github.runsecure</groupId>
      <artifactId>hkdfguard-pipeline</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.runsecure</groupId>
      <artifactId>hkdfguard-integration-hashicorpvault</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.runsecure</groupId>
      <artifactId>hkdfguard-remote-common</artifactId>
    </dependency>

    <!-- The tests protect values with a real AES-256-GCM pipeline protector, in the default format. -->
    <dependency>
      <groupId>io.github.runsecure</groupId>
      <artifactId>hkdfguard-dataencryptionkey</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.github.runsecure</groupId>
      <artifactId>hkdfguard-cryptoprovider-aesgcm256</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <executions>
          <execution>
            <id>default-testCompile</id>
            <configuration>
              <compilerArgs>
                <arg>--add-modules=jdk.httpserver</arg>
                <arg>${hkdfguard.httpserver.reads}</arg>
              </compilerArgs>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- The contract every pipeline writer meets, compiled into this module's tests from
           hkdfguard-pipeline's sources: one copy of the source, never shipped. -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>add-contract-test-sources</id>
            <phase>generate-test-sources</phase>
            <goals>
              <goal>add-test-source</goal>
            </goals>
            <configuration>
              <sources>
                <source>${project.basedir}/../hkdfguard-pipeline/src/contract-test/java</source>
              </sources>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
