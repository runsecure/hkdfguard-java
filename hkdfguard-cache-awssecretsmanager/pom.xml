<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.runsecure</groupId>
    <artifactId>hkdfguard-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>hkdfguard-cache-awssecretsmanager</artifactId>
  <name>HkdfGuard Cache AWS Secrets Manager</name>
  <description>
    A protected read-only cache over AWS Secrets Manager: each secret is read on its first lookup,
    taken out of the response before the SDK can make it a String, encrypted under the key ring's
    current key and cached only as ciphertext.
  </description>

  <dependencies>
    <dependency>
      <groupId>io.github.runsecure</groupId>
      <artifactId>hkdfguard-cache</artifactId>
    </dependency>

    <!-- The application builds, configures and closes the SecretsManagerAsyncClient, and with it
         chooses the HTTP client it runs on (netty-nio-client, aws-crt-client, ...), as with
         hkdfguard-keywrapping-awskms: both transports the SDK declares are excluded, so depending on
         this module doesn't put either on every consumer's class path. -->
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>secretsmanager</artifactId>
      <exclusions>
        <exclusion>
          <groupId>software.amazon.awssdk</groupId>
          <artifactId>netty-nio-client</artifactId>
        </exclusion>
        <exclusion>
          <groupId>software.amazon.awssdk</groupId>
          <artifactId>apache5-client</artifactId>
        </exclusion>
      </exclusions>
    </dependency>

    <!-- The integration test builds a real SecretsManagerAsyncClient, which needs an asynchronous
         HTTP client. The other tests answer the real client from a stub HTTP client, with no
         network. -->
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>netty-nio-client</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- The tests encrypt under a real key ring of AES-256-GCM keys. -->
    <dependency>
      <groupId>io.github.runsecure</groupId>
      <artifactId>hkdfguard-dataencryptionkey</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.github.runsecure</groupId>
      <artifactId>hkdfguard-cryptoprovider-aesgcm256</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
