<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd"
         child.project.url.inherit.append.path="false">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.runsecure</groupId>
  <artifactId>hkdfguard-parent</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>HkdfGuard</name>
  <description>HkdfGuard key wrapping and secret protection library for Java.</description>
  <url>https://github.com/runsecure/hkdfguard-java</url>

  <!-- Every module is licensed under the Mozilla Public License 2.0 (see LICENSE). -->
  <licenses>
    <license>
      <name>MPL-2.0</name>
      <url>https://www.mozilla.org/en-US/MPL/2.0/</url>
    </license>
  </licenses>

  <!-- Maven Central requires at least one developer on every published POM. -->
  <developers>
    <developer>
      <id>torinblair</id>
      <name>Torin Blair</name>
      <organization>runsecure</organization>
      <organizationUrl>https://github.com/runsecure</organizationUrl>
    </developer>
  </developers>

  <scm child.scm.connection.inherit.append.path="false"
       child.scm.developerConnection.inherit.append.path="false"
       child.scm.url.inherit.append.path="false">
    <url>https://github.com/runsecure/hkdfguard-java</url>
    <connection>scm:git:https://github.com/runsecure/hkdfguard-java.git</connection>
    <developerConnection>scm:git:git@github.com:runsecure/hkdfguard-java.git</developerConnection>
  </scm>

  <issueManagement>
    <system>GitHub</system>
    <url>https://github.com/runsecure/hkdfguard-java/issues</url>
  </issueManagement>

  <modules>
    <module>hkdfguard-diagnostics</module>
    <module>hkdfguard-abstractions</module>
    <module>hkdfguard-cryptoprovider-aesgcm256</module>
    <module>hkdfguard-keywrapping-v1</module>
    <module>hkdfguard-dataencryptionkey</module>
    <module>hkdfguard-cache</module>
    <module>hkdfguard-options</module>
    <module>hkdfguard-spring-boot-starter</module>
  </modules>

  <properties>
    <!-- The bytecode level every module targets unless it says otherwise: Java 21, the previous
         Long Term Support release, so applications still on 21 can use the cryptographic core
         (diagnostics, abstractions, the AES-GCM provider, key rings and caches). Only
         hkdfguard-keywrapping-v1 needs Java 25 and overrides this: its native calls use the Foreign
         Function & Memory API, final only from Java 22. Building still needs JDK 25 (see the
         enforcer's requireJavaVersion) because that module is part of every build. -->
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <!-- Reproducible builds: a fixed timestamp in every archive entry. -->
    <project.build.outputTimestamp>2026-10-12T05:38:12Z</project.build.outputTimestamp>

    <bouncycastle.version>1.86</bouncycastle.version>
    <opentelemetry.version>1.67.0</opentelemetry.version>
    <slf4j.version>2.0.20</slf4j.version>
    <junit.version>6.1.3</junit.version>

    <!-- The KeyWrapping module calls the native KMS library through the FFM API, a restricted
         API: tests grant it native access explicitly rather than relying on the JDK's warning. -->
    <hkdfguard.test.argLine>--enable-native-access=ALL-UNNAMED</hkdfguard.test.argLine>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.github.runsecure</groupId>
        <artifactId>hkdfguard-diagnostics</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.runsecure</groupId>
        <artifactId>hkdfguard-abstractions</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.runsecure</groupId>
        <artifactId>hkdfguard-cryptoprovider-aesgcm256</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.runsecure</groupId>
        <artifactId>hkdfguard-keywrapping-v1</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.runsecure</groupId>
        <artifactId>hkdfguard-dataencryptionkey</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.runsecure</groupId>
        <artifactId>hkdfguard-cache</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.runsecure</groupId>
        <artifactId>hkdfguard-options</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.runsecure</groupId>
        <artifactId>hkdfguard-spring-boot-starter</artifactId>
        <version>${project.version}</version>
      </dependency>

      <dependency>
        <groupId>org.bouncycastle</groupId>
        <artifactId>bcprov-jdk18on</artifactId>
        <version>${bouncycastle.version}</version>
      </dependency>
      <dependency>
        <groupId>io.opentelemetry</groupId>
        <artifactId>opentelemetry-bom</artifactId>
        <version>${opentelemetry.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.slf4j</groupId>
        <artifactId>slf4j-api</artifactId>
        <version>${slf4j.version}</version>
      </dependency>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.16.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.6.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>3.5.1</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-enforcer-plugin</artifactId>
          <version>3.6.3</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-wrapper-plugin</artifactId>
          <version>3.3.4</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-source-plugin</artifactId>
          <version>3.4.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-javadoc-plugin</artifactId>
          <version>3.12.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-gpg-plugin</artifactId>
          <version>3.2.8</version>
        </plugin>
        <plugin>
          <groupId>org.sonatype.central</groupId>
          <artifactId>central-publishing-maven-plugin</artifactId>
          <version>0.12.0</version>
        </plugin>
        <!-- The release workflow stamps the tag's version into every POM with versions:set. -->
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>versions-maven-plugin</artifactId>
          <version>2.23.0</version>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-toolchain</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[25,)</version>
                </requireJavaVersion>
                <requireMavenVersion>
                  <version>[3.9,)</version>
                </requireMavenVersion>
                <dependencyConvergence/>
                <!-- Every third-party version is exact: no ranges, LATEST/RELEASE or snapshots,
                     so a build is reproducible and a new release (of BouncyCastle, say) only
                     arrives as a reviewed Dependabot pull request. This project's own modules
                     are exempt, since they are snapshots between releases. -->
                <banDynamicVersions>
                  <ignores>
                    <ignore>io.github.runsecure:*</ignore>
                  </ignores>
                </banDynamicVersions>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <executions>
          <!-- The shipped libraries build warning-free and stay that way. Excluded: automatic-
               module warnings (OpenTelemetry's jars are automatic modules) and the module lint,
               whose only finding is the terminal digits in names kept identical to the .NET
               assemblies (aesgcm256, v1). -->
          <execution>
            <id>default-compile</id>
            <configuration>
              <compilerArgs>
                <arg>-Xlint:all,-requires-automatic,-requires-transitive-automatic,-module</arg>
                <arg>-Werror</arg>
              </compilerArgs>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <argLine>${hkdfguard.test.argLine}</argLine>
          <!-- Native integration tests read HKDFGUARD_TEST_SERVICE from the environment. -->
          <trimStackTrace>false</trimStackTrace>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- Sources and javadoc jars, which Maven Central requires. CI builds with this profile on so a
         javadoc error fails a pull request, not a release. -->
    <profile>
      <id>dist</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <executions>
              <execution>
                <id>attach-sources</id>
                <goals>
                  <goal>jar-no-fork</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <goals>
                  <goal>jar</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!-- Signs every artifact and publishes to Maven Central through the Central Portal. Run only by
         .github/workflows/release.yml, together with dist. The signing key and passphrase come from
         the MAVEN_GPG_KEY and MAVEN_GPG_PASSPHRASE environment variables (BouncyCastle signer, so no
         gpg install or agent is needed); the Portal token from the "central" server in settings.xml. -->
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals>
                  <goal>sign</goal>
                </goals>
                <configuration>
                  <signer>bc</signer>
                  <bestPractices>true</bestPractices>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <!-- Publishing to Central is permanent: a version can never be replaced or deleted.
                   The release workflow's "release" environment is where a human approves it. -->
              <autoPublish>true</autoPublish>
              <waitUntil>published</waitUntil>
              <deploymentName>hkdfguard-java ${project.version}</deploymentName>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
