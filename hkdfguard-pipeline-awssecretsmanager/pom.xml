<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.runsecure</groupId>
    <artifactId>hkdfguard-parent</artifactId>
    <version>0.9.1</version>
  </parent>

  <artifactId>hkdfguard-pipeline-awssecretsmanager</artifactId>
  <name>HkdfGuard Pipeline AWS Secrets Manager</name>
  <description>
    A provisioning pipeline's writer over AWS Secrets Manager: pulls a fixed list of secrets, each
    taken out of the response and encrypted at once with a pipeline data protector before the SDK can
    make it a String, and writes one encrypted file per secret, with no key ring.
  </description>

  <properties>
    <!-- Java 25, like hkdfguard-pipeline. -->
    <maven.compiler.release>25</maven.compiler.release>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.github.runsecure</groupId>
      <artifactId>hkdfguard-pipeline</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.runsecure</groupId>
      <artifactId>hkdfguard-remote-common</artifactId>
    </dependency>

    <!-- The application builds, configures and closes the SecretsManagerAsyncClient, and with it
         chooses the HTTP client it runs on, as with hkdfguard-cache-awssecretsmanager: both
         transports the SDK declares are excluded, so depending on this module doesn't put either on
         every consumer's class path. -->
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>secretsmanager</artifactId>
      <exclusions>
        <exclusion>
          <groupId>software.amazon.awssdk</groupId>
          <artifactId>netty-nio-client</artifactId>
        </exclusion>
        <exclusion>
          <groupId>software.amazon.awssdk</groupId>
          <artifactId>apache5-client</artifactId>
        </exclusion>
      </exclusions>
    </dependency>

    <!-- The tests answer a real SecretsManagerAsyncClient from a stub HTTP client, with no network,
         and protect values with a real AES-256-GCM pipeline protector, in the default format. -->
    <dependency>
      <groupId>io.github.runsecure</groupId>
      <artifactId>hkdfguard-dataencryptionkey</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.github.runsecure</groupId>
      <artifactId>hkdfguard-cryptoprovider-aesgcm256</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- The contract every pipeline writer meets, compiled into this module's tests from
           hkdfguard-pipeline's sources: one copy of the source, never shipped. -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>add-contract-test-sources</id>
            <phase>generate-test-sources</phase>
            <goals>
              <goal>add-test-source</goal>
            </goals>
            <configuration>
              <sources>
                <source>${project.basedir}/../hkdfguard-pipeline/src/contract-test/java</source>
              </sources>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
